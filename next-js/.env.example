# Copy to .env and fill in. Every variable is validated in env.ts.
# `npm run sanity:project-setup` writes most of these for you.

# Public site origin, no trailing slash. Used for canonical URLs, OG, sitemap.
NEXT_PUBLIC_URL=http://localhost:3000

# Sanity project. Placeholder ids let `npm run build` pass without a project.
NEXT_PUBLIC_SANITY_PROJECT_ID=abcd1234
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-02-19
NEXT_PUBLIC_SANITY_STUDIO_BASE_PATH=/studio

# Viewer token: reads drafts in draft mode and Presentation.
SANITY_API_VIEW_TOKEN=
# Editor token: writes submissions and agent fields. Server only.
SANITY_API_EDIT_TOKEN=
# Shared secret for the /api/revalidate GROQ webhook.
SANITY_REVALIDATE_SECRET=
# Optional override. Default: CDN off in production, on in development.
# SANITY_USE_CDN=false

# HTTP basic auth credentials. The toggle lives in the Site document.
BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD=

# Signs the contact form timing token. Any long random string.
FORM_SECRET=change-me-to-a-long-random-string

# Resend. Leave the key empty to store submissions without emailing.
RESEND_API_KEY=
RESEND_FROM=Site <noreply@example.com>

# Umami analytics. Both empty disables the script.
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
NEXT_PUBLIC_UMAMI_SRC=https://cloud.umami.is/script.js

# Mux (Studio video plugin).
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=

# Set to 1 to skip env validation (CI lint jobs, Docker builds).
# SKIP_ENV_VALIDATION=
