# Public (exposed to the browser, Astro requires the PUBLIC_ prefix)
PUBLIC_URL=http://localhost:4321
PUBLIC_SANITY_PROJECT_ID=abcd1234
PUBLIC_SANITY_DATASET=production
PUBLIC_SANITY_API_VERSION=2025-02-19
PUBLIC_SANITY_STUDIO_BASE_PATH=/studio
PUBLIC_UMAMI_WEBSITE_ID=
PUBLIC_UMAMI_SRC=

# Sanity tokens (server only)
SANITY_API_VIEW_TOKEN=
SANITY_API_EDIT_TOKEN=
SANITY_REVALIDATE_SECRET=change-me-revalidate
# Optional override: "true" or "false". Default: false in production, true in development.
SANITY_USE_CDN=

# Basic auth (used when site.security.basicAuthEnabled or a document has passwordProtect)
BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD=

# Forms
FORM_SECRET=change-me-form-secret
RESEND_API_KEY=
RESEND_FROM=Site <noreply@example.com>

# Mux (Studio plugin, sanity-plugin-mux-input)
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=

# Studio (Sanity CLI + embedded Studio read these; keep in sync with PUBLIC_*)
SANITY_STUDIO_PROJECT_ID=abcd1234
SANITY_STUDIO_DATASET=production

# Set to 1 to skip env validation (CI, one-off scripts)
# SKIP_ENV_VALIDATION=1
