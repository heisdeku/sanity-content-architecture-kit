---
import type { NavLink } from './navigation-model';

interface Props {
  links: NavLink[];
  label: string;
  class?: string;
}
const { links, label, class: className } = Astro.props;
const current = Astro.url.pathname;
---

{
  links.length > 0 && (
    <nav aria-label={label} class={className}>
      <ul class="flex flex-wrap items-center gap-x-5 gap-y-2 text-sm">
        {links.map((link) => (
          <li>
            <a
              href={link.href}
              target={link.newTab ? '_blank' : undefined}
              rel={link.newTab ? 'noopener noreferrer' : undefined}
              aria-current={current === link.href ? 'page' : undefined}
              class="text-muted transition-colors hover:text-foreground aria-[current=page]:text-foreground"
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  )
}
