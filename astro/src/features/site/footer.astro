---
import Navigation from './navigation.astro';
import type { NavColumn, NavLink } from './navigation-model';

interface Props {
  name: string;
  columns: NavColumn[];
  social: NavLink[];
}
const { name, columns, social } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="mt-auto border-t border-border">
  <div class="container-content grid gap-10 py-12 md:grid-cols-[1.5fr_repeat(auto-fit,minmax(10rem,1fr))]">
    <div>
      <p class="font-semibold tracking-tight">{name}</p>
      <p class="mt-2 text-sm text-muted">&copy; {year} {name}. All rights reserved.</p>
    </div>
    {
      columns.map((column) => (
        <div>
          {column.title && <p class="mb-3 text-sm font-medium">{column.title}</p>}
          <ul class="space-y-2 text-sm">
            {column.links.map((link) => (
              <li>
                <a
                  href={link.href}
                  target={link.newTab ? '_blank' : undefined}
                  rel={link.newTab ? 'noopener noreferrer' : undefined}
                  class="text-muted transition-colors hover:text-foreground"
                >
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>
  {
    social.length > 0 && (
      <div class="container-content border-t border-border py-6">
        <Navigation links={social} label="Social" />
      </div>
    )
  }
</footer>
