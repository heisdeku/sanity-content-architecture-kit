---
import RichText from '@/features/rich-text/rich-text.astro';
import { cn } from '@/features/style/cn';
import Heading from '../heading.astro';
import Media from '../media.astro';
import type { SectionOf } from '../types';

interface Props extends SectionOf<'sectionImageText'> {
  path: string;
  index: number;
}
const { heading, body, media, imagePosition } = Astro.props;
---

<section class="section-spacing">
  <div class="container-content grid gap-10 md:grid-cols-2 md:items-center">
    <div class={cn('grid gap-5', imagePosition === 'left' && 'md:order-2')}>
      <Heading heading={heading} />
      <RichText value={body} />
    </div>
    <Media media={media} sizes="(min-width: 768px) 50vw, 100vw" class="rounded-lg" />
  </div>
</section>
