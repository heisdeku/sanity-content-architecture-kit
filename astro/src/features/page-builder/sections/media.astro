---
import Media from '../media.astro';
import type { SectionOf } from '../types';

interface Props extends SectionOf<'sectionMedia'> {
  path: string;
  index: number;
}
const { media, caption } = Astro.props;
---

<section class="section-spacing">
  <figure class="container-content grid gap-3">
    <Media media={media} sizes="(min-width: 1088px) 1088px, 100vw" class="rounded-lg" />
    {caption && <figcaption class="text-sm text-muted">{caption}</figcaption>}
  </figure>
</section>
