---
// Smooth scrolling via Lenis. Vanilla script instead of a React island so it
// runs before hydration and survives Astro view transitions. It stays off
// when the visitor prefers reduced motion or on coarse pointers.
---

<script>
  import Lenis from 'lenis';

  let lenis: Lenis | null = null;
  let frame = 0;

  function shouldRun() {
    return (
      !window.matchMedia('(prefers-reduced-motion: reduce)').matches &&
      !window.matchMedia('(hover: none) and (pointer: coarse)').matches
    );
  }

  function start() {
    stop();
    if (!shouldRun()) return;
    lenis = new Lenis({ lerp: 0.1, smoothWheel: true });
    const raf = (time: number) => {
      lenis?.raf(time);
      frame = requestAnimationFrame(raf);
    };
    frame = requestAnimationFrame(raf);
  }

  function stop() {
    cancelAnimationFrame(frame);
    lenis?.destroy();
    lenis = null;
  }

  document.addEventListener('astro:page-load', start);
  document.addEventListener('astro:before-swap', stop);
</script>
