---
interface Props {
  enabled: boolean;
}
const { enabled } = Astro.props;
---

{
  enabled && (
    <div class="sticky top-0 z-50 flex items-center justify-between gap-4 border-b border-border bg-muted-background px-4 py-2 text-sm">
      <span>
        <strong class="font-medium">Draft mode</strong> is on. You are viewing unpublished content.
      </span>
      <a href="/api/draft-mode/disable" class="underline underline-offset-2" data-astro-reload>
        Exit
      </a>
    </div>
  )
}
