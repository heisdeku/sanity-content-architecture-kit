{
  "$schema": "https://biomejs.dev/schemas/2.5.12/schema.json",
  "vcs": { "enabled": false, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "includes": [
      "**",
      "!**/node_modules",
      "!**/dist",
      "!**/.astro",
      "!**/.vercel",
      // Shared studio workspace and its scripts are authored in ../next-js and copied
      // verbatim (byte-identical); Biome must not reformat them here.
      "!**/sanity",
      "!sanity.config.ts",
      "!sanity.cli.ts",
      "!**/scripts",
      "!**/sanity-schema.json",
      "!**/package-lock.json",
      "!**/seed",
      "!**/backups",
      "!**/templates"
    ]
  },
  "css": { "parser": { "tailwindDirectives": true }, "linter": { "enabled": true } },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": { "quoteStyle": "single", "semicolons": "always", "trailingCommas": "all" }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": { "noExplicitAny": "error" },
      "style": { "useImportType": "error", "noNonNullAssertion": "warn" },
      "correctness": { "noUnusedImports": "error", "noUnusedVariables": "warn" },
      // prefers-reduced-motion must win over utilities; !important is the standard idiom.
      "complexity": { "noImportantStyles": "off" }
    }
  },
  "overrides": [
    {
      // The section generator writes literal ${FRAGMENT} interpolations into the GROQ file.
      "includes": ["plopfile.mjs"],
      "linter": { "rules": { "suspicious": { "noTemplateCurlyInString": "off" } } }
    },
    {
      // Biome only sees the frontmatter of .astro files, so variables used in
      // the template look unused.
      "includes": ["**/*.astro"],
      "linter": {
        "rules": { "correctness": { "noUnusedVariables": "off", "noUnusedImports": "off" } }
      }
    }
  ],
  "assist": { "actions": { "source": { "organizeImports": "on" } } }
}
